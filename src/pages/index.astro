---
import Layout from '../layouts/Layout.astro';

const proyectos = [
  {
    year: '2026',
    title: 'TikEntry - Sistema de entradas por QR',
    desc: 'Aplicación web fullstack para la gestión de entradas a eventos con control de acceso mediante códigos QR. Permite a los organizadores crear, distribuir y validar entradas en tiempo real con múltiples puertas de acceso simultáneas. ',
    tags: ['React', 'TypeScript', 'TailwindCSS', 'Node.js', 'Express', 'esbuild', 'Supabase', 'PostgreSQL', 'Nodemailer'],
    link: '#',
    i18nKey: 'proyectos.tikentry'
  },
  {
    year: '2025-2026',
    title: 'SiGU — Sistema de Gestión Universitaria',
    desc: `SiGU es una plataforma de gestión académica universitaria con roles diferenciados para estudiantes, docentes, secretaría académica y administración: inscripción a materias y exámenes, carga de notas, correlatividades, mesas de examen, anuncios por materia y gestión de usuarios.\nNació como proyecto de la cátedra de Ingeniería de Software I y II, y después lo seguí trabajando por mi cuenta: corregí bugs reales, cerré vulnerabilidades de control de acceso, armé tests, y reorganicé la arquitectura (controladores → capa de servicios).`,
    tags: ['Java', 'Spark', 'ActiveJDBC', 'MySQL'],
    link: 'https://github.com/lukacha3/SiGU',
    gallery: [
      '/img/proyectos/sigu/sigu-1.png',
      '/img/proyectos/sigu/sigu-2.png',
      '/img/proyectos/sigu/sigu-3.png',
      '/img/proyectos/sigu/sigu-4.png',
      '/img/proyectos/sigu/sigu-5.png',
      '/img/proyectos/sigu/sigu-6.png',
      '/img/proyectos/sigu/sigu-7.png'
    ],
    i18nKey: 'proyectos.sigu'
  },
  {
    year: '2026',
    title: 'Mas proyectos en construcción',
    desc: 'Poco a poco iré actualizando el porfolio con mas proyectos interesantes!',
    i18nKey: 'proyectos.wip'
    // tags: ['Stack', 'Aquí'],
    // link: '#'
  }
];

const stack = [
  { name: 'Lenguajes', i18nKey: 'stack.cat.lenguajes', items: [
    { name: 'Java', iconUrl: 'https://api.iconify.design/mdi:language-java.svg?color=%23F00000', color: '#F00000' },
    { name: 'C', slug: 'c', color: '#A8B9CC', colorLight: '#5C7A99' },
    { name: 'TypeScript', slug: 'typescript', color: '#3178C6' },
    { name: 'SQL', iconUrl: 'https://api.iconify.design/mdi:database.svg?color=%2394A3B8', color: '#80a3d5ff' }
  ] },
  { name: 'Frontend', i18nKey: 'stack.cat.frontend', items: [
    { name: 'React', slug: 'react', color: '#61DAFB', colorLight: '#0E7FA6' },
    { name: 'TailwindCSS', slug: 'tailwindcss', color: '#06B6D4', colorLight: '#058ea6' },
    { name: 'HTML', slug: 'html5', color: '#E34F26' },
    { name: 'CSS', slug: 'css', color: '#1572B6' }
  ] },
  { name: 'Backend y APIs', i18nKey: 'stack.cat.backend', items: [
    { name: 'Node.js', slug: 'nodedotjs', color: '#339933' },
    { name: 'Express', slug: 'express', color: '#FFFFFF', colorLight: '#000000' },
    { name: 'APIs REST', iconUrl: 'https://api.iconify.design/mdi:api.svg?color=%234A7C6F', color: '#b36818ff' },
    { name: 'esbuild', slug: 'esbuild', color: '#FFCF00', colorLight: '#A38400' },
    { name: 'Nodemailer', iconUrl: 'https://api.iconify.design/mdi:email-fast-outline.svg?color=%234A7C6F', color: '#21af5cff' },
    { name: 'Spark', iconUrl: 'https://api.iconify.design/mdi:flash.svg?color=%23F7A41D', color: '#F7A41D', colorLight: '#C78111' },
    { name: 'ActiveJDBC', iconUrl: 'https://api.iconify.design/mdi:database-sync-outline.svg?color=%234A7C6F', color: '#4A7C6F' }
  ] },
  { name: 'Bases de datos', i18nKey: 'stack.cat.db', items: [
    { name: 'PostgreSQL', slug: 'postgresql', color: '#4169E1' },
    { name: 'MySQL', slug: 'mysql', color: '#4479A1' },
    { name: 'Supabase', slug: 'supabase', color: '#38c045ff', colorLight: '#249461' }
  ] },
  { name: 'Herramientas y control de versiones', i18nKey: 'stack.cat.tools', items: [
    { name: 'Git', slug: 'git', color: '#F05032' },
    { name: 'GitHub', slug: 'github', color: '#FFFFFF', colorLight: '#181717' },
    { name: 'Apache Maven', slug: 'apachemaven', color: '#C71A36' },
    { name: 'Gradle', slug: 'gradle', color: '#117085ff' },
    { name: 'GitFlow', slug: 'git', color: '#F05032' }
  ] },
  { name: 'Sistemas', i18nKey: 'stack.cat.systems', items: [
    { name: 'Linux', slug: 'linux', color: '#fcb424ff', colorLight: '#8A6D00' },
    { name: 'Bash', slug: 'gnubash', color: '#4EAA25' },
    { name: 'Windows', iconUrl: 'https://api.iconify.design/simple-icons:windows.svg?color=%2300A4EF', color: '#00A4EF' },
    { name: 'PowerShell', iconUrl: 'https://api.iconify.design/simple-icons:powershell.svg?color=%235391FE', color: '#5391FE' }
  ] }
];

const getStackItem = (name: string) => {
  for (const category of stack) {
    const item = category.items.find((i) => i.name === name);
    if (item) {
      const colorLight = item.colorLight || item.color;
      let iconUrlLight = item.iconUrl;
      let iconUrlDark = item.iconUrl;
      let slugUrlLight = null;
      let slugUrlDark = null;
      
      if (item.iconUrl) {
        iconUrlDark = item.iconUrl;
        iconUrlLight = item.iconUrl.replace(/color=.*?(&|$)/, `color=%23${colorLight.replace('#', '')}$1`);
      } else if (item.slug && item.color) {
        slugUrlDark = `https://cdn.simpleicons.org/${item.slug}/${item.color.replace('#', '')}`;
        slugUrlLight = `https://cdn.simpleicons.org/${item.slug}/${colorLight.replace('#', '')}`;
      }
      return {
        ...item,
        colorLight,
        iconUrlLight,
        iconUrlDark,
        slugUrlLight,
        slugUrlDark
      };
    }
  }
  return { name };
};
---
<Layout title="Luka Chaves Felici — Portfolio">
  <nav class="side-nav">
    <div class="toggles-container">
      <button id="lang-toggle" class="toggle-btn" aria-label="Cambiar idioma">EN</button>
      <button id="theme-toggle" class="toggle-btn" aria-label="Cambiar tema">
        <img id="theme-icon" src="https://api.iconify.design/mdi:weather-sunny.svg?color=%23e8e6e1" alt="Tema" width="20" height="20" />
      </button>
    </div>
    <a href="#intro" class="nav-link" data-i18n="nav.intro">Introducción</a>
    <a href="#stack" class="nav-link" data-i18n="nav.stack">Stack</a>
    <a href="#proyectos" class="nav-link" data-i18n="nav.proyectos">Proyectos</a>
    <a href="#contacto" class="nav-link" data-i18n="nav.contacto">Contacto</a>
  </nav>
  <div class="wrap">
    <div class="hero-about-wrapper">
      <header id="intro" class="hero">
        <p class="eyebrow" data-i18n="hero.eyebrow">&gt; estudiante de ciencias de la computación</p>
        <h1>Luka Chaves Felici</h1>
        <p data-i18n="hero.desc">Estudiante avanzado de Analista en Ciencias de la Computación en la Universidad Nacional de Rio Cuarto (UNRC). Formación sólida en Programación Orientada a Objetos con Java, diseño y normalización de bases de datos relacionales (SQL) y control de versiones con Git/GitHub. Experiencia en desarrollo en equipo aplicando Scrum y GitFlow. Busco incorporarme como desarrollador para aportar mis conocimientos y habilidades en software.</p>
        <nav class="links">
          <button type="button" class="mail-btn contact-link">
            <img class="contact-icon" data-icon="mdi:email-outline" src="https://api.iconify.design/mdi:email-outline.svg?color=%23e8e6e1" alt="" width="16" height="16" />
            email
          </button>
          <a href="https://github.com/lukacha3" target="_blank" class="contact-link">
            <img class="contact-icon" data-icon="mdi:github" src="https://api.iconify.design/mdi:github.svg?color=%23e8e6e1" alt="" width="16" height="16" />
            github
          </a>
          <a href="https://www.linkedin.com/in/luka-chaves-felici/" target="_blank" class="contact-link">
            <img class="contact-icon" data-icon="mdi:linkedin" src="https://api.iconify.design/mdi:linkedin.svg?color=%23e8e6e1" alt="" width="16" height="16" />
            linkedin
          </a>
        </nav>
      </header>

      <section class="block about">
        <h2 data-i18n="about.title">Sobre mí</h2>
        <div data-i18n="about.desc">
          <p>Soy un estudiante que apunta al perfil de Full-Stack developer. Me apasiona la tecnología en todas sus formas: además del desarrollo, dedico buena parte de mi tiempo libre a explorar sistemas operativos, especialmente Linux, y a automatizar tareas con scripts de bash. Me gusta meterme a fondo en la administración de sistemas y también en el hardware, entender cómo funciona algo desde la base es parte de lo que más disfruto de esto.</p>
          <p>Soy detallista y proactivo: no me conformo con la primera solución que funciona, sino que busco pensar de forma iterativa y algorítmica hasta encontrar el mejor enfoque. Me capacito constantemente con cursos y nuevas tecnologías, porque siento que en este campo nunca se termina de aprender.</p>
        </div>
      </section>
    </div>

    <section id="stack" class="block stack-section">
      <h2 data-i18n="stack.title">Stack</h2>
      <div class="stack-grid">
        {stack.map((category) => (
          <article class="stack-card">
            <h3 data-i18n={category.i18nKey}>{category.name}</h3>
            <div class="tags">
              {category.items.map((i) => {
                const item = getStackItem(i.name);
                return (
                  <div 
                    class="stack-tag"
                    style={item.color ? `--brand-dark: ${item.color}; --brand-light: ${item.colorLight};` : null}
                  >
                    {item.slugUrlDark && (
                      <img 
                        class="stack-icon"
                        src={item.slugUrlDark} 
                        data-src-dark={item.slugUrlDark}
                        data-src-light={item.slugUrlLight}
                        alt="" 
                        width="24" 
                        height="24" 
                        loading="lazy"
                      />
                    )}
                    {item.iconUrlDark && (
                      <img 
                        class="stack-icon"
                        src={item.iconUrlDark} 
                        data-src-dark={item.iconUrlDark}
                        data-src-light={item.iconUrlLight}
                        alt="" 
                        width="24" 
                        height="24" 
                        loading="lazy"
                      />
                    )}
                    {item.name}
                  </div>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="proyectos" class="block">
      <h2 data-i18n="proyectos.title">Proyectos</h2>
      {proyectos.map((p) => (
        <article class="project">
          <div class="year">
            {p.year}
            {p.gallery && p.gallery.length > 0 && (
              <div class="gallery-thumb" data-gallery={JSON.stringify(p.gallery)}>
                <img src={p.gallery[0]} alt={`Galería de ${p.title}`} loading="lazy" />
                <div class="gallery-overlay">
                  <span>+{p.gallery.length}</span>
                </div>
              </div>
            )}
          </div>
          <div>
            <h3 data-i18n={`${p.i18nKey}.title`}>{p.title}</h3>
            <div data-i18n={`${p.i18nKey}.desc`}>
              {p.desc.split('\n').map((line) => line.trim() ? <p>{line.trim()}</p> : null)}
            </div>
            {p.tags && p.tags.length > 0 && (
              <div class="tags">
                {p.tags.map((t) => {
                  const item = getStackItem(t);
                  return (
                    <span 
                      class="stack-tag" 
                      style={item.color ? `--brand-dark: ${item.color}; --brand-light: ${item.colorLight};` : null}
                    >
                      {item.slugUrlDark && (
                        <img 
                          class="stack-icon"
                          src={item.slugUrlDark} 
                          data-src-dark={item.slugUrlDark}
                          data-src-light={item.slugUrlLight}
                          alt="" 
                          width="14" 
                          height="14" 
                        />
                      )}
                      {item.iconUrlDark && (
                        <img 
                          class="stack-icon"
                          src={item.iconUrlDark} 
                          data-src-dark={item.iconUrlDark}
                          data-src-light={item.iconUrlLight}
                          alt="" 
                          width="14" 
                          height="14" 
                        />
                      )}
                      {item.name}
                    </span>
                  );
                })}
              </div>
            )}
            {p.link && <a class="project-link" href={p.link} data-i18n="proyectos.link">ver proyecto →</a>}
          </div>
        </article>
      ))}
    </section>

    <footer id="contacto">
      <nav class="links footer-links">
        <button type="button" class="mail-btn contact-link">
          <img class="contact-icon" data-icon="mdi:email-outline" src="https://api.iconify.design/mdi:email-outline.svg?color=%23e8e6e1" alt="" width="16" height="16" />
          email
        </button>
        <a href="https://github.com/lukacha3" target="_blank" class="contact-link">
          <img class="contact-icon" data-icon="mdi:github" src="https://api.iconify.design/mdi:github.svg?color=%23e8e6e1" alt="" width="16" height="16" />
          github
        </a>
        <a href="https://www.linkedin.com/in/luka-chaves-felici/" target="_blank" class="contact-link">
          <img class="contact-icon" data-icon="mdi:linkedin" src="https://api.iconify.design/mdi:linkedin.svg?color=%23e8e6e1" alt="" width="16" height="16" />
          linkedin
        </a>
      </nav>
      <p data-i18n="footer.madeby">hecho por Luka Chaves Felici — {new Date().getFullYear()}</p>
    </footer>
  </div>
  <div id="toast" class="toast" role="status" aria-live="polite" data-i18n="toast.copied">correo copiado al portapapeles</div>

  <div id="lightbox" class="lightbox" aria-modal="true" role="dialog" hidden>
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-content">
      <div class="lightbox-header">
        <span id="lightbox-counter"></span>
        <button id="lightbox-close" aria-label="Cerrar galería">&times;</button>
      </div>
      <div class="lightbox-body">
        <button id="lightbox-prev" aria-label="Anterior">&#10094;</button>
        <img id="lightbox-img" src="" alt="Imagen ampliada" />
        <button id="lightbox-next" aria-label="Siguiente">&#10095;</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const user = 'lukacha033';
  const domain = 'gmail.com';
  const email = `${user}@${domain}`;

  const mailBtns = document.querySelectorAll('.mail-btn');
  const toast = document.getElementById('toast');
  let hideTimeout;

  mailBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const temp = document.createElement('textarea');
        temp.value = email;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
      }
      toast?.classList.add('show');
      clearTimeout(hideTimeout);
      hideTimeout = setTimeout(() => toast?.classList.remove('show'), 2200);
    });
  });

  // LIGHTBOX LOGIC
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCounter = document.getElementById('lightbox-counter');
  const btnClose = document.getElementById('lightbox-close');
  const btnPrev = document.getElementById('lightbox-prev');
  const btnNext = document.getElementById('lightbox-next');
  
  let currentGallery: string[] = [];
  let currentIndex = 0;

  function updateLightbox() {
    if (currentGallery.length === 0 || !lightboxImg) return;
    lightboxImg.src = currentGallery[currentIndex];
    if (lightboxCounter) {
      lightboxCounter.textContent = `${currentIndex + 1} / ${currentGallery.length}`;
    }
  }

  // ZOOM LOGIC
  let isZoomed = false;
  let isDragging = false;
  let didDrag = false;
  let startX = 0, startY = 0;
  let translateX = 0, translateY = 0;

  function resetZoom() {
    isZoomed = false;
    translateX = 0;
    translateY = 0;
    if (lightboxImg) {
      lightboxImg.style.transition = 'transform 0.2s ease';
      lightboxImg.style.transform = 'translate(0px, 0px) scale(1)';
      lightboxImg.style.cursor = 'zoom-in';
    }
  }

  lightboxImg.addEventListener('mousedown', (e) => {
    if (isZoomed) {
      isDragging = true;
      didDrag = false;
      startX = e.clientX - translateX;
      startY = e.clientY - translateY;
      lightboxImg.style.cursor = 'grabbing';
      lightboxImg.style.transition = 'none';
      e.preventDefault();
    }
  });

  window.addEventListener('mousemove', (e) => {
    if (isDragging) {
      didDrag = true;
      translateX = e.clientX - startX;
      translateY = e.clientY - startY;
      lightboxImg.style.transform = `translate(${translateX}px, ${translateY}px) scale(1.8)`;
    }
  });

  window.addEventListener('mouseup', () => {
    if (isDragging) {
      isDragging = false;
      lightboxImg.style.cursor = 'grab';
      lightboxImg.style.transition = 'transform 0.2s ease';
    }
  });

  lightboxImg.addEventListener('click', (e) => {
    if (didDrag) {
      didDrag = false;
      return;
    }
    if (!isZoomed) {
      isZoomed = true;
      lightboxImg.style.cursor = 'grab';
      lightboxImg.style.transform = `translate(0px, 0px) scale(1.8)`;
    } else {
      resetZoom();
    }
  });

  function showLightbox(gallery: string[], startIndex: number) {
    currentGallery = gallery;
    currentIndex = startIndex;
    resetZoom();
    updateLightbox();
    if (lightbox) lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (lightbox) lightbox.hidden = true;
    document.body.style.overflow = '';
    currentGallery = [];
    resetZoom();
  }

  function nextImage() {
    if (currentGallery.length > 0) {
      currentIndex = (currentIndex + 1) % currentGallery.length;
      resetZoom();
      updateLightbox();
    }
  }

  function prevImage() {
    if (currentGallery.length > 0) {
      currentIndex = (currentIndex - 1 + currentGallery.length) % currentGallery.length;
      resetZoom();
      updateLightbox();
    }
  }

  document.querySelectorAll('.gallery-thumb').forEach(thumb => {
    thumb.addEventListener('click', () => {
      const galleryData = thumb.getAttribute('data-gallery');
      if (galleryData) {
        try {
          const gallery = JSON.parse(galleryData);
          if (gallery.length > 0) {
            showLightbox(gallery, 0);
          }
        } catch (e) {
          console.error("Invalid gallery data", e);
        }
      }
    });
  });

  btnClose?.addEventListener('click', closeLightbox);
  btnNext?.addEventListener('click', nextImage);
  btnPrev?.addEventListener('click', prevImage);

  lightbox?.addEventListener('click', (e) => {
    if (e.target && (e.target as HTMLElement).classList.contains('lightbox-backdrop')) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox && !lightbox.hidden) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    }
  });

  // THEME, I18N & SCROLL SPY LOGIC
  const translations = {
    es: {
      'hero.eyebrow': '> estudiante de ciencias de la computación',
      'hero.desc': 'Estudiante avanzado de Analista en Ciencias de la Computación en la Universidad Nacional de Rio Cuarto (UNRC). Formación sólida en Programación Orientada a Objetos con Java, diseño y normalización de bases de datos relacionales (SQL) y control de versiones con Git/GitHub. Experiencia en desarrollo en equipo aplicando Scrum y GitFlow. Busco incorporarme como desarrollador para aportar mis conocimientos y habilidades en software.',
      'nav.intro': 'Introducción',
      'nav.stack': 'Stack',
      'nav.proyectos': 'Proyectos',
      'nav.contacto': 'Contacto',
      'about.title': 'Sobre mí',
