  };

  const themeToggle = document.getElementById('theme-toggle');
  const langToggle = document.getElementById('lang-toggle');
  const themeIcon = document.getElementById('theme-icon');
  const contactLinks = document.querySelectorAll('.contact-link');

  function applyLanguage(lang) {
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      const text = translations[lang]?.[key];
      if (text) {
        if (text.includes('\n')) {
          el.innerHTML = text.split('\n').map(l => `<p>${l.trim()}</p>`).join('');
        } else {
          el.textContent = text;
        }
      }
    });
    if (langToggle) {
      langToggle.textContent = lang === 'es' ? 'EN' : 'ES';
    }
    localStorage.setItem('lang', lang);
  }

  const savedLang = localStorage.getItem('lang') || 'es';
  if (savedLang === 'en') applyLanguage('en');

  langToggle?.addEventListener('click', () => {
    const activeLang = localStorage.getItem('lang') || 'es';
    const newLang = activeLang === 'es' ? 'en' : 'es';
    applyLanguage(newLang);
  });

  function getThemeColor() {
    return document.documentElement.getAttribute('data-theme') === 'light' ? '%231e293b' : '%23e8e6e1';
  }
  function getAccentColor() {
    return document.documentElement.getAttribute('data-theme') === 'light' ? '%23b28c1d' : '%23c9a227';
  }

  function updateDynamicIcons() {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const themeColor = getThemeColor();
    
    document.querySelectorAll('.contact-icon').forEach(img => {
      img.src = `https://api.iconify.design/${img.dataset.icon}.svg?color=${themeColor}`;
    });
    
    document.querySelectorAll('.stack-icon').forEach(img => {
      img.src = isLight ? img.dataset.srcLight : img.dataset.srcDark;
    });

    const favicon = document.getElementById('favicon');
    if (favicon) {
      favicon.href = isLight ? '/favicon-light.svg' : '/favicon.svg';
    }
  }
  
  if (themeIcon && document.documentElement.getAttribute('data-theme') === 'light') {
    themeIcon.src = 'https://api.iconify.design/mdi:weather-night.svg?color=%231e293b';
  }
  updateDynamicIcons();

  contactLinks.forEach(link => {
    link.addEventListener('mouseenter', () => {
      const img = link.querySelector('img');
      if (img) img.src = `https://api.iconify.design/${img.dataset.icon}.svg?color=${getAccentColor()}`;
    });
    link.addEventListener('mouseleave', () => {
      const img = link.querySelector('img');
      if (img) img.src = `https://api.iconify.design/${img.dataset.icon}.svg?color=${getThemeColor()}`;
    });
  });

  themeToggle?.addEventListener('click', () => {
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    if (isLight) {
      document.documentElement.removeAttribute('data-theme');
      localStorage.setItem('theme', 'dark');
      themeIcon.src = 'https://api.iconify.design/mdi:weather-sunny.svg?color=%23e8e6e1';
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('theme', 'light');
      themeIcon.src = 'https://api.iconify.design/mdi:weather-night.svg?color=%231e293b';
    }
    updateDynamicIcons();
  });

  const sections = document.querySelectorAll('#intro, #stack, #proyectos, #contacto');
  const navLinks = document.querySelectorAll('.nav-link');

  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      if (link.getAttribute('href') === '#intro') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  });

  function updateSpy() {
    let current = 'intro';
    const scrollY = window.scrollY;

    sections.forEach(sec => {
      const rect = sec.getBoundingClientRect();
      // Si el top de la sección cruzó el tercio superior de la pantalla
      if (rect.top <= window.innerHeight / 3) {
        current = sec.getAttribute('id');
      }
    });

    // Forzar contacto si estamos al final de la página (con margen de 50px)
    if ((window.innerHeight + scrollY) >= document.documentElement.scrollHeight - 50) {
      current = 'contacto';
    }

    navLinks.forEach(link => {
      link.classList.toggle('active', link.getAttribute('href') === `#${current}`);
    });
  }

  window.addEventListener('scroll', updateSpy, { passive: true });
  window.addEventListener('resize', updateSpy, { passive: true });
  updateSpy();
</script>
